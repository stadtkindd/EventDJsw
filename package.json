{
  "name": "eventdj",
  "productName": "EventDJ",
  "version": "1.1.0",
  "description": "Jingle-Player für Event-DJs (Sport, Hallen, Veranstaltungen) – Touch & Maus, Windows",
  "main": "src/main/main.js",
  "author": "stadtkindd",
  "license": "MIT",
  "homepage": "https://github.com/stadtkindd/EventDJsw",
  "repository": {
    "type": "git",
    "url": "https://github.com/stadtkindd/EventDJsw.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "test": "node test/model.test.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.stadtkindd.eventdj",
    "productName": "EventDJ",
    "copyright": "© stadtkindd",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "edjset",
        "name": "EventDJ Set",
        "description": "EventDJ Set (Reiter, Kacheln & Audio)"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EventDJ",
      "artifactName": "EventDJ-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "EventDJ-Portable-${version}.${ext}"
    }
  }
}
